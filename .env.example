# Public client config. Copy to .env and fill in. All EXPO_PUBLIC_* vars are
# inlined into the app binary — treat them as public. Do not commit .env.
# Never put a PostHog personal API key (phx_) in an EXPO_PUBLIC_ variable.
# The dashboard script reads POSTHOG_PERSONAL_API_KEY from the shell only.

# PostHog product analytics (EU cloud) — public project key, safe to bundle.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Set to 1 to send events from __DEV__ builds (off by default). Leave unset for EAS production/preview.
EXPO_PUBLIC_POSTHOG_ENABLE_DEV=

# EAS Build does not read this file. Create the same names as EAS environment
# variables (expo.dev → Environment variables), for example:
#   eas env:create --name EXPO_PUBLIC_POSTHOG_KEY --value phc_... --visibility plaintext --environment production
#   eas env:create --name EXPO_PUBLIC_POSTHOG_HOST --value https://eu.i.posthog.com --visibility plaintext --environment production
# See src/lib/analytics/README.md.
